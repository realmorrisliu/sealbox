# Example .env file for Sealbox

# Static authentication token for API access
SEALBOX_AUTH_TOKEN=your_secret_token_here

# SQLite database file path
SEALBOX_STORE_PATH=./sealbox.db

# Address and port to listen on
SEALBOX_LISTEN_ADDR=0.0.0.0:8080

# Server master key(s), most-current first, comma-separated. The first encrypts new secrets;
# any others are retired but still loaded so their secrets stay readable and can be rekeyed.
# Generate with:  openssl genrsa -out master.pem 2048
SEALBOX_MASTER_KEY_PATH=./master.pem
